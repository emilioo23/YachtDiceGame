<Window x:Class="YachtDice.Views.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Viewbox Stretch="Uniform">
        <Grid Margin="24" Width="1000" Height="800">
            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>

                    <!-- ENCABEZADO -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{x:Static properties:Strings.Leaderboard_Title}"
                               FontFamily="{StaticResource FontDisplay}" FontSize="33"
                               Foreground="{StaticResource BrushText}"/>
                    </Grid>
                    <TextBlock Text="{x:Static properties:Strings.Leaderboard_BackLink}"
                           Style="{StaticResource LinkText}" Margin="0,0,0,20" FontSize="18"
                           MouseLeftButtonUp="BackLink_Click"/>

                    <!-- FILTROS -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="GlobalFilterButton" Content="{x:Static properties:Strings.Leaderboard_FilterGlobal}"
                            Style="{StaticResource TabButtonActive}" Padding="24,9" Margin="0,0,10,0"
                            Click="GlobalFilterButton_Click" FontSize="18"/>
                        <Button x:Name="FriendsFilterButton" Content="{x:Static properties:Strings.Leaderboard_FilterFriends}"
                            Style="{StaticResource BtnOutline}" Padding="24,9"
                            Click="FriendsFilterButton_Click" FontSize="18"/>
                    </StackPanel>

                    <!-- TABLA -->
                    <Border Background="{StaticResource BrushCream2}" CornerRadius="10"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>

                            <!-- CABECERA DE TABLA -->
                            <Grid Background="{StaticResource BrushWood}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static properties:Strings.Leaderboard_ColumnRank}"
                                       FontSize="15" FontWeight="Bold" Foreground="White" Padding="14,10"/>
                                <TextBlock Grid.Column="1" Text="{x:Static properties:Strings.Leaderboard_ColumnPlayer}"
                                       FontSize="15" FontWeight="Bold" Foreground="White" Padding="0,10"/>
                                <TextBlock Grid.Column="2" Text="{x:Static properties:Strings.Leaderboard_ColumnLevel}"
                                       FontSize="15" FontWeight="Bold" Foreground="White" Padding="0,10"/>
                                <TextBlock Grid.Column="3" Text="{x:Static properties:Strings.Leaderboard_ColumnPoints}"
                                       FontSize="15" FontWeight="Bold" Foreground="White" Padding="0,10"/>
                                <TextBlock Grid.Column="4" Text="{x:Static properties:Strings.Leaderboard_ColumnWins}"
                                       FontSize="15" FontWeight="Bold" Foreground="White" Padding="0,10"/>
                            </Grid>

                            <!-- FILAS: se generan por codigo -->
                            <StackPanel x:Name="RankingPanel"/>

                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="YourPositionTextBlock" Text="{Binding TODO_Propiedad}" d:Text="Tu posición: #0"
                           FontSize="16" Foreground="{StaticResource BrushTextMuted}"/>

                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</Window>
