<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="urn:yachtdice:contracts" elementFormDefault="qualified" targetNamespace="urn:yachtdice:contracts" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="LoginCredentials">
    <xs:sequence>
      <xs:element minOccurs="0" name="CultureName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Password" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LoginCredentials" nillable="true" type="tns:LoginCredentials" />
  <xs:complexType name="LoginData">
    <xs:sequence>
      <xs:element minOccurs="0" name="ChallengeId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Code" type="tns:LoginResultCode" />
      <xs:element minOccurs="0" name="DisplayName" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LoginData" nillable="true" type="tns:LoginData" />
  <xs:simpleType name="LoginResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="VerificationCodeSent" />
      <xs:enumeration value="MissingRequiredField" />
      <xs:enumeration value="InvalidCredentials" />
      <xs:enumeration value="VerificationLocked" />
      <xs:enumeration value="CodeSendFailed" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="LoginResultCode" nillable="true" type="tns:LoginResultCode" />
  <xs:complexType name="ServiceFault">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:ServiceErrorCode" />
      <xs:element minOccurs="0" name="Message" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ServiceFault" nillable="true" type="tns:ServiceFault" />
  <xs:simpleType name="ServiceErrorCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UnexpectedError" />
      <xs:enumeration value="DatabaseUnavailable" />
      <xs:enumeration value="InvalidRequest" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ServiceErrorCode" nillable="true" type="tns:ServiceErrorCode" />
  <xs:complexType name="VerificationDetails">
    <xs:sequence>
      <xs:element minOccurs="0" name="ChallengeId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Code" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="VerificationDetails" nillable="true" type="tns:VerificationDetails" />
  <xs:simpleType name="VerificationResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Valid" />
      <xs:enumeration value="Incorrect" />
      <xs:enumeration value="Expired" />
      <xs:enumeration value="Locked" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="VerificationResultCode" nillable="true" type="tns:VerificationResultCode" />
  <xs:complexType name="ResendCodeDetails">
    <xs:sequence>
      <xs:element minOccurs="0" name="ChallengeId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="CultureName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ResendCodeDetails" nillable="true" type="tns:ResendCodeDetails" />
  <xs:simpleType name="ResendResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CodeSent" />
      <xs:enumeration value="ResendTooSoon" />
      <xs:enumeration value="VerificationLocked" />
      <xs:enumeration value="CodeSendFailed" />
      <xs:enumeration value="PlayerNotFound" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ResendResultCode" nillable="true" type="tns:ResendResultCode" />
</xs:schema>