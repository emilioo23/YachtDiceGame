<Window x:Class="YachtDice.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}"
        Height="800"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1100"
              Height="800">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Border Grid.Column="0"
                    Style="{StaticResource CardPanel}"
                    Margin="0,0,16,0">

                <StackPanel>

                    <TextBlock Text="{x:Static properties:Strings.Profile_ChooseAvatar}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,16"/>

                    <Border Width="120"
                            Height="120"
                            CornerRadius="60"
                            Background="{StaticResource BrushCream2}"
                            BorderBrush="{StaticResource BrushGold}"
                            BorderThickness="3"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">

                        <Image x:Name="AvatarPreviewImage"
                               Margin="3"/>
                    </Border>

                    <TextBlock x:Name="LevelTextBlock"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ItemsControl x:Name="AvatarOptionsItemsControl"
                                  Margin="0,0,0,20">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="3"
                                        CornerRadius="30"
                                        BorderThickness="3"
                                        Background="Transparent"
                                        Tag="{Binding Id}"
                                        MouseLeftButtonUp="AvatarOption_Click">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="Cursor"
                                                    Value="Hand"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource BrushGold}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUnlocked}"
                                                             Value="False">
                                                    <Setter Property="Cursor"
                                                            Value="Arrow"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Image Width="46"
                                               Height="46"
                                               Source="{Binding Id, Converter={StaticResource AvatarImageConverter}}">

                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}"
                                                                     Value="False">
                                                            <Setter Property="Opacity"
                                                                    Value="0.35"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Border Background="{StaticResource BrushWoodDark}"
                                                CornerRadius="8"
                                                Padding="5,1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}"
                                                                     Value="False">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding RequiredLevel,
                                                StringFormat={x:Static properties:Strings.Profile_AvatarLockedBadge}}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardPanel}">

                <StackPanel>

                    <Grid Margin="0,0,0,20">

                        <TextBlock Text="{x:Static properties:Strings.Profile_CustomizeProfileTitle}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="26"
                                   Foreground="{StaticResource BrushText}"/>

                        <Button Content="{x:Static properties:Strings.Global_ButtonBack}"
                                Style="{StaticResource BtnOutline}"
                                HorizontalAlignment="Right"
                                Padding="14,6"
                                FontSize="18"
                                Click="BackButton_Click"/>
                    </Grid>

                    <TextBlock Text="{x:Static properties:Strings.Profile_Username}"
                               Style="{StaticResource FieldLabel}"
                               FontSize="18"/>

                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource TextBoxRounded}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{x:Static properties:Strings.Profile_TitleLabel}"
                               Style="{StaticResource FieldLabel}"
                               FontSize="18"/>

                    <ComboBox
                              Padding="10,8"
                              FontSize="17"
                              Margin="0,0,0,24"
                              SelectedIndex="0">

                        <ComboBoxItem Content="{x:Static properties:Strings.Profile_TitleBeginner}"/>
                        <ComboBoxItem Content="{x:Static properties:Strings.Profile_TitleExpert}"/>
                        <ComboBoxItem Content="{x:Static properties:Strings.Profile_TitleChampion}"/>
                        <ComboBoxItem Content="{x:Static properties:Strings.Profile_TitleShooter}"/>
                        <ComboBoxItem Content="{x:Static properties:Strings.Profile_TitleStrategist}"/>

                    </ComboBox>

                    <TextBlock Text="{x:Static properties:Strings.Profile_StatisticsHeader}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,10"/>

                    <Border Background="{StaticResource BrushCream2}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Margin="0,0,0,24">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_StatGames}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_StatWins}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_StatBestScore}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_TotalXp}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static properties:Strings.Profile_Achievements_Header}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,24">

                        <Border Background="{StaticResource BrushGoldButton}"
                                CornerRadius="16"
                                Padding="12,7"
                                Margin="0,0,8,8">

                            <TextBlock Text="{x:Static properties:Strings.Profile_Achievements_FirstMatch}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushFeltDark}"/>
                        </Border>

                        <Border Background="{StaticResource BrushGoldButton}"
                                CornerRadius="16"
                                Padding="12,7"
                                Margin="0,0,8,8">

                            <TextBlock Text="{x:Static properties:Strings.Profile_Achievements_FirstWin}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushFeltDark}"/>
                        </Border>

                        <Border Background="{StaticResource BrushBorder}"
                                CornerRadius="16"
                                Padding="12,7"
                                Margin="0,0,8,8"
                                Opacity="0.6">

                            <TextBlock Text="{x:Static properties:Strings.Profile_Achievements_SpeedRoller}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </Border>

                    </WrapPanel>

                    <Button Content="{x:Static properties:Strings.Profile_ButtonSaveChanges}"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            Padding="0,13"
                            Click="SaveChangesButton_Click"/>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>