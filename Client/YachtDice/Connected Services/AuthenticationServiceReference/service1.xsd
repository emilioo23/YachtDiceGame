<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://tempuri.org/" elementFormDefault="qualified" targetNamespace="http://tempuri.org/" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import namespace="urn:yachtdice:contracts" />
  <xs:element name="Login">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q1="urn:yachtdice:contracts" minOccurs="0" name="request" nillable="true" type="q1:LoginCredentials" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="LoginResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q2="urn:yachtdice:contracts" minOccurs="0" name="LoginResult" nillable="true" type="q2:LoginData" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="VerifyCode">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q3="urn:yachtdice:contracts" minOccurs="0" name="request" nillable="true" type="q3:VerificationDetails" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="VerifyCodeResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q4="urn:yachtdice:contracts" minOccurs="0" name="VerifyCodeResult" type="q4:VerificationResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ResendCode">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q5="urn:yachtdice:contracts" minOccurs="0" name="request" nillable="true" type="q5:ResendCodeDetails" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ResendCodeResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q6="urn:yachtdice:contracts" minOccurs="0" name="ResendCodeResult" type="q6:ResendResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>