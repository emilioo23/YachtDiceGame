<Window x:Class="YachtDice.Views.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        Title="{x:Static properties:Strings.Auth_Logo}" Width="450" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border Background="{DynamicResource BrushCardBackground}" 
            BorderBrush="{DynamicResource BrushBorder}" 
            BorderThickness="1.5" CornerRadius="10" Margin="35"
            Effect="{DynamicResource ShadowCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BrushCream2}" 
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

            <TextBlock Grid.Row="0" x:Name="TitleText" Foreground="{DynamicResource BrushGold}" 
                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0" 
                       IsHitTestVisible="False"/>

            <Button Grid.Row="0" Content="{x:Static properties:Strings.Global_SymbolClose}" Foreground="{DynamicResource BrushTextMuted}" 
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Width="30" Height="30"
                    FontSize="14" Click="SecondaryButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Row="1" x:Name="MessageText" Foreground="{DynamicResource BrushText}" FontSize="14" 
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Margin="20,30,20,20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button x:Name="PrimaryButton" Content="{x:Static properties:Strings.Dialogs_OKButton}"
                        Style="{DynamicResource BtnPrimary}" MinWidth="130"
                        Click="PrimaryButton_Click"/>

                <Button x:Name="SecondaryButton" Style="{DynamicResource BtnOutline}"
                        MinWidth="130" Margin="12,0,0,0" Visibility="Collapsed"
                        Click="SecondaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>