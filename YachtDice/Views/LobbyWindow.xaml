<Window x:Class="YachtDice.Views.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1280"
              Height="800">

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Border Style="{StaticResource CardPanel}"
                    Width="760"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <!-- ENCABEZADO -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Static properties:Strings.Lobby_Title}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="36"
                                   Foreground="{StaticResource BrushText}"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource BrushCream2}"
                                CornerRadius="8"
                                Padding="12,6">

                            <TextBlock x:Name="RoomCodeTextBlock"
                                       d:Text="ID: 4821"
                                       FontWeight="Bold"
                                       FontSize="23"
                                       Foreground="{StaticResource BrushWoodDark}"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{x:Static properties:Strings.Lobby_BackToPlay}"
                               Style="{StaticResource LinkText}"
                               Margin="0,0,0,20"
                               FontSize="15"
                               MouseLeftButtonUp="BackToPlayLink_Click"/>

                    <!-- PRIVACIDAD / MAX JUGADORES -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_Privacy}"
                                       Style="{StaticResource FieldLabel}"
                                       FontSize="15"/>

                            <ComboBox x:Name="PrivacyComboBox"
                                      Padding="10,8"
                                      FontSize="17"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="{x:Static properties:Strings.Lobby_OptionPrivate}"/>
                                <ComboBoxItem Content="{x:Static properties:Strings.Lobby_OptionPublic}"/>

                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_MaxPlayers}"
                                       Style="{StaticResource FieldLabel}"
                                       FontSize="15"/>

                            <ComboBox x:Name="MaxPlayersComboBox"
                                      Padding="10,8"
                                      FontSize="17"
                                      SelectedIndex="2">

                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>

                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- MODO DE JUEGO -->
                    <TextBlock Text="{x:Static properties:Strings.Lobby_GameMode}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NormalModeBorder"
                                Grid.Column="0"
                                Background="{StaticResource BrushCream2}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource BrushFeltLight}"
                                BorderThickness="2"
                                Padding="16"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="NormalMode_Click">

                            <StackPanel>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode1MinuteTitle}"
                                           FontFamily="{StaticResource FontBodySemibold}"
                                           FontSize="19"
                                           Foreground="{StaticResource BrushWoodDark}"/>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode1MinuteSub}"
                                           FontSize="15"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>

                            </StackPanel>
                        </Border>

                        <Border x:Name="FastModeBorder"
                                Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5"
                                Padding="16"
                                Margin="10,0,0,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="FastMode_Click">

                            <StackPanel>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode30SecondsTitle}"
                                           FontFamily="{StaticResource FontBodySemibold}"
                                           FontSize="19"
                                           Foreground="{StaticResource BrushWoodDark}"/>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode30SecondsSub}"
                                           FontSize="15"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>

                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- JUGADORES -->
                    <Grid Margin="0,0,0,10">

                        <TextBlock Text="{x:Static properties:Strings.Lobby_Players}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"/>

                        <TextBlock x:Name="PlayerCountTextBlock"
                                   d:Text="(1/4)"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource BrushCream2}"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,6,0">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="{StaticResource BrushWood}"
                                        Margin="0,0,8,0">

                                    <TextBlock x:Name="PlayerInitialTextBlock"
                                               d:Text="U"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="15"/>
                                </Border>

                                <StackPanel>

                                    <TextBlock x:Name="PlayerNameTextBlock"
                                               d:Text="Tú"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="{StaticResource BrushText}"/>

                                    <TextBlock Text="{x:Static properties:Strings.Lobby_Host}"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushFeltLight}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="6,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_WaitingPlayer}"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="2"
                                Background="Transparent"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="6,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_WaitingPlayer}"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="3"
                                Background="Transparent"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="6,0,0,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_WaitingPlayer}"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- BOTONES -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{x:Static properties:Strings.Lobby_ButtonCopyCode}"
                                Style="{StaticResource BtnOutline}"
                                Margin="0,0,10,0"
                                Padding="0,13"
                                FontSize="17"
                                Click="CopyCodeButton_Click"/>

                        <Button Grid.Column="1"
                                Content="{x:Static properties:Strings.Lobby_ButtonStartMatch}"
                                Style="{StaticResource BtnPrimary}"
                                FontSize="17"
                                Padding="0,13"
                                Click="StartGameButton_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>