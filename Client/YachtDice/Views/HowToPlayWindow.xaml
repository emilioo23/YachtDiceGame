<Window x:Class="YachtDice.Views.HowToPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}"
        Height="800"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Window.Resources>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="21"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Margin"
                    Value="0,18,0,10"/>
        </Style>

        <Style x:Key="BodyText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Foreground"
                    Value="{StaticResource BrushText}"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="CategoryRuleTemplate">
            <Border Background="{StaticResource BrushCream2}"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <views:DiceRow Grid.Column="0"
                                   Dice="{Binding Dice}"
                                   VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Title}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushFeltLight}"
                                   Margin="0,0,0,2"/>

                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1000"
              Height="800">

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Border Style="{StaticResource CardPanel}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{x:Static properties:Strings.HowToPlay_Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="33"
                               Foreground="{StaticResource BrushText}"/>

                    <TextBlock Grid.Row="1"
                               Text="{x:Static properties:Strings.Global_ButtonBack}"
                               Style="{StaticResource LinkText}"
                               FontSize="18"
                               Margin="0,4,0,10"
                               MouseLeftButtonUp="BackLink_Click"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="0,0,14,0">

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_Subtitle}"
                                       Style="{StaticResource BodyText}"
                                       FontStyle="Italic"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_GoalTitle}"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_GoalText}"
                                       Style="{StaticResource BodyText}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_TurnTitle}"
                                       Style="{StaticResource SectionTitle}"/>

                            <ItemsControl x:Name="StepsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="30"
                                                    Height="30"
                                                    CornerRadius="15"
                                                    Background="{StaticResource BrushFeltLight}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">

                                                <TextBlock Text="{Binding Number}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_UpperTitle}"
                                       Style="{StaticResource SectionTitle}"/>

                            <ItemsControl x:Name="UpperRulesItemsControl"
                                          ItemTemplate="{StaticResource CategoryRuleTemplate}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_LowerTitle}"
                                       Style="{StaticResource SectionTitle}"/>

                            <ItemsControl x:Name="LowerRulesItemsControl"
                                          ItemTemplate="{StaticResource CategoryRuleTemplate}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_WinTitle}"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_WinText}"
                                       Style="{StaticResource BodyText}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_TipsTitle}"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="{x:Static properties:Strings.HowToPlay_TipsText}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
