<?xml version="1.0" encoding="utf-8"?>
<services>
	<service name="YachtDice.Server.Services.AuthenticationService" behaviorConfiguration="DefaultServiceBehavior">
		<host>
			<baseAddresses>
				<add baseAddress="net.tcp://localhost:8733/YachtDice/Authentication" />
			</baseAddresses>
		</host>
		<endpoint address="" binding="netTcpBinding" bindingConfiguration="DefaultNetTcpBinding" contract="YachtDice.Server.Contracts.Authentication.IAuthenticationService" />
		<endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
	</service>

