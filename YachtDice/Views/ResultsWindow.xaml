<Window x:Class="YachtDice.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice" Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontBody}">

    <Grid>
        <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,16,16,0"
                                 Panel.ZIndex="99"/>

        <Border Style="{StaticResource CardPanel}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock x:Name="WinnerTitleTextBlock" Text="{Binding TODO_Propiedad}" d:Text="Jugador ganó"
                           FontFamily="{StaticResource FontDisplay}" FontSize="26"
                           Foreground="{StaticResource BrushText}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScoreSubtitleTextBlock" Text="{Binding TODO_Propiedad}" d:Text="Puntaje ganador: 0 pts"
                           FontSize="14" Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" Margin="0,4,0,26"/>

                <Border Background="{StaticResource BrushCream2}" CornerRadius="10"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TODO_Propiedad}" d:Text="🥇" FontSize="16" Padding="14,10" Grid.ColumnSpan="2" Margin="6,3,229,26" Grid.RowSpan="2"/>
                        <TextBlock Grid.Column="1" Text="{x:Static properties:Strings.Results_ColumnPlayer}"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="16,18,38,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static properties:Strings.Results_ColumnTotal}"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Padding="14,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static properties:Strings.Results_ColumnXp}"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Padding="0,0,14,0"/>

                        <TextBlock Grid.Column="0" Text="{Binding TODO_Propiedad}" d:Text="🥈" FontSize="16" Padding="14,10" Grid.ColumnSpan="2" Margin="6,41,229,0" Grid.RowSpan="2"/>
                        <TextBlock x:Name="OpponentNameTextBlock" Grid.Row="1" Grid.Column="1" Text="{Binding TODO_Propiedad}" d:Text="DiegoL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="16,7,38,0"/>
                        <TextBlock x:Name="OpponentScoreTextBlock" Grid.Row="1" Grid.Column="2" Text="{Binding TODO_Propiedad}" d:Text="0" FontSize="13" Foreground="{StaticResource BrushText}" VerticalAlignment="Center" Padding="14,0"/>
                        <TextBlock Text="{Binding TODO_Propiedad}" d:Text="+0" FontSize="13" Foreground="{StaticResource BrushFeltLight}" FontWeight="Bold" VerticalAlignment="Center" Padding="0,0,14,0"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{x:Static properties:Strings.Results_MenuButton}"
                            Style="{StaticResource BtnOutline}" Padding="26,12" Margin="0,0,10,0" Click="MenuButton_Click"/>
                    <Button Content="{x:Static properties:Strings.Results_NewGameButton}"
                            Style="{StaticResource BtnPrimary}" Padding="26,12" Click="NewGameButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
