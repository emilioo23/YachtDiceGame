<Window x:Class="YachtDice.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}" Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontBody}">

    <Grid>
        <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,16,16,0"
                                 Panel.ZIndex="99"/>

        <Border Style="{StaticResource CardPanel}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock x:Name="WinnerTitleTextBlock"
                           FontFamily="{StaticResource FontDisplay}" FontSize="26"
                           Foreground="{StaticResource BrushText}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScoreSubtitleTextBlock"
                           FontSize="14" Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" Margin="0,4,0,26"/>

                <Border Background="{StaticResource BrushCream2}" CornerRadius="10"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,24"
                        Padding="14,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static properties:Strings.Results_ColumnRank}"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="{x:Static properties:Strings.Results_ColumnPlayer}"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="2" Text="{x:Static properties:Strings.Results_ColumnTotal}"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                        </Grid>

                        <ItemsControl x:Name="StandingsItemsControl" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PlaceText}" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="13"
                                                   FontWeight="Bold" Foreground="{StaticResource BrushFeltLight}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{x:Static properties:Strings.Results_ButtonMenu}"
                            Style="{StaticResource BtnOutline}" Padding="26,12" Margin="0,0,10,0" Click="MenuButton_Click"/>
                    <Button Content="{x:Static properties:Strings.Results_ButtonNewGame}"
                            Style="{StaticResource BtnPrimary}" Padding="26,12" Click="NewGameButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
