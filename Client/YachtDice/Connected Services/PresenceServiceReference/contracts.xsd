<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="urn:yachtdice:contracts" elementFormDefault="qualified" targetNamespace="urn:yachtdice:contracts" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import namespace="http://schemas.microsoft.com/2003/10/Serialization/Arrays" />
  <xs:element name="Connect">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ConnectResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q1="http://schemas.microsoft.com/2003/10/Serialization/Arrays" minOccurs="0" name="ConnectResult" nillable="true" type="q1:ArrayOfstring" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Disconnect">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PresenceChanged">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="eventType" type="tns:PresenceEventType" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="PresenceEventType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PlayerConnected" />
      <xs:enumeration value="PlayerDisconnected" />
      <xs:enumeration value="FriendRequestReceived" />
      <xs:enumeration value="FriendRequestAccepted" />
      <xs:enumeration value="FriendRemoved" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="PresenceEventType" nillable="true" type="tns:PresenceEventType" />
</xs:schema>