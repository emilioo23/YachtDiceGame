<Window x:Class="YachtDice.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice" Height="570" Width="508"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontBody}">

    <Grid>
        <views:LanguageSwitcher HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,16,16,0"
                                 Panel.ZIndex="99"/>

        <Border Style="{StaticResource CardPanel}" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock Text="{x:Static properties:Strings.ForgotPassword_Title}"
                           FontFamily="{StaticResource FontBodySemibold}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushFeltLight}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static properties:Strings.ForgotPassword_Title}"
                           FontFamily="{StaticResource FontBodySemibold}"
                           FontSize="23" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static properties:Strings.ForgotPassword_Description}"
                           FontSize="15"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <TextBlock Text="{x:Static properties:Strings.ForgotPassword_Email}"
                           Style="{StaticResource FieldLabel}"
                           FontSize="14"/>
                <TextBox x:Name="EmailTextBox"
                         Style="{StaticResource TextBoxRounded}"
                         Margin="0,0,0,20"/>

                <Button x:Name="SendLinkButton"
                        Content="{x:Static properties:Strings.ForgotPassword_SendLinkButton}"
                        Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch"
                        FontSize="15" Padding="0,13"
                        Margin="0,0,0,16"
                        Click="SendLinkButton_Click"/>

                <TextBlock Text="{x:Static properties:Strings.ForgotPassword_BackToLoginLink}"
                           Style="{StaticResource LinkText}"
                           HorizontalAlignment="Center"
                           MouseLeftButtonUp="BackToLoginLink_Click"
                           FontSize="15"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
