<Window x:Class="YachtDice.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{x:Static properties:Strings.Auth_Logo}"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Window.Resources>
        <RadialGradientBrush x:Key="BrushTableFelt"
                             Center="0.5,0.5"
                             RadiusX="0.75"
                             RadiusY="0.75">
            <GradientStop Color="#3D8A66" Offset="0"/>
            <GradientStop Color="#1E4A37" Offset="1"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="BrushWoodRing"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#9C6B3E" Offset="0"/>
            <GradientStop Color="#5C3D24" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="DownOnly">

        <Grid Margin="16"
              Width="1248"
              Height="768">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:LanguageSwitcher
                x:Name="LanguageSwitcherControl"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-8,0,0"
                Panel.ZIndex="99"/>

            <Border Grid.Column="0"
                    Style="{StaticResource CardPanel}"
                    Margin="0,0,12,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BrushWood}"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,10">

                        <Grid>
                            <TextBlock
                                x:Name="TurnTextBlock"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="17"
                                VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <TextBlock
                                    x:Name="TimerTextBlock"
                                    Foreground="{StaticResource BrushGold}"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Margin="0,0,12,0"/>

                                <TextBlock
                                    x:Name="RoundInfoTextBlock"
                                    Foreground="{StaticResource BrushCream2}"
                                    FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,0,17,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl x:Name="MatchPlayersItemsControl"
                                      Grid.Column="1"
                                      Focusable="False">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0">

                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLeft}"
                                                                 Value="True">
                                                        <Setter Property="Opacity"
                                                                Value="0.45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="18"
                                                BorderThickness="2"
                                                HorizontalAlignment="Center">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource BrushFeltLight}"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource BrushBorder}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocalPlayer}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BrushWood}"/>
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource BrushGold}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Image Source="{Binding AvatarId,
                                                           Converter={StaticResource AvatarImageConverter}}"
                                                   Width="32"
                                                   Height="32"/>
                                        </Border>

                                        <TextBlock Text="{Binding Name}"
                                                   ToolTip="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Visible"
                                  Margin="0,0,0,10">

                        <StackPanel x:Name="CategoriesPanel"/>
                    </ScrollViewer>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="{x:Static properties:Strings.Game_Sidebar_ButtonHowToPlay}"
                            Style="{StaticResource BtnOutline}"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            Padding="12,6"
                            Click="HowToPlayButton_Click"/>

                        <Button
                            x:Name="KickPlayerButton"
                            Grid.Column="1"
                            Content="{x:Static properties:Strings.Game_Sidebar_ButtonKick}"
                            Style="{StaticResource BtnOutline}"
                            FontSize="14"
                            Padding="8,6"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="KickPlayerButton_Click"/>

                        <Button
                            Grid.Column="2"
                            Content="{x:Static properties:Strings.Game_Sidebar_ButtonLeave}"
                            Style="{StaticResource BtnOutline}"
                            Foreground="{StaticResource BrushDanger}"
                            FontSize="14"
                            Padding="8,6"
                            Click="LeaveMatchButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardPanel}"
                        Margin="0,0,0,12">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <Border Width="380"
                                Height="380"
                                CornerRadius="190"
                                Background="{StaticResource BrushWoodRing}"
                                Effect="{StaticResource ShadowCard}"
                                Margin="0,0,0,16">

                            <Border Width="330"
                                    Height="330"
                                    CornerRadius="165"
                                    Background="{StaticResource BrushTableFelt}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Canvas x:Name="DiceCanvas"
                                        Width="330"
                                        Height="330"/>
                            </Border>
                        </Border>

                        <Button
                            x:Name="RollButton"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            Padding="40,12"
                            Margin="0,0,0,8"
                            Click="RollButton_Click"/>

                        <TextBlock
                            x:Name="HintTextBlock"
                            FontSize="11"
                            Foreground="{StaticResource BrushCream2}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>

                <views:ChatPanel x:Name="ChatPanelControl"
                                 Grid.Row="1"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>