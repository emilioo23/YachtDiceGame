<Window x:Class="YachtDice.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:utils="clr-namespace:YachtDice.Utils"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}"
        Height="800"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1000"
              Height="800">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardPanel}"
                    Padding="16"
                    Margin="0,0,16,0">

                <StackPanel>

                    <TextBlock Text="{x:Static properties:Strings.Settings_Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="32"
                               Foreground="{StaticResource BrushText}"
                               Margin="0,0,0,20"/>

                    <Button x:Name="AccountNavButton"
                            Content="{x:Static properties:Strings.Settings_Nav_Account}"
                            Style="{StaticResource TabButtonActive}"
                            Margin="0,0,0,8"
                            Click="AccountNavButton_Click"
                            FontSize="19"/>

                    <Button x:Name="AppearanceNavButton"
                            Content="{x:Static properties:Strings.Settings_Nav_Appearance}"
                            Style="{StaticResource BtnOutline}"
                            Margin="0,0,0,8"
                            Click="AppearanceNavButton_Click"
                            FontSize="19"/>

                    <Button x:Name="SecurityNavButton"
                            Content="{x:Static properties:Strings.Settings_Nav_Security}"
                            Style="{StaticResource BtnOutline}"
                            Margin="0,0,0,8"
                            Click="SecurityNavButton_Click"
                            FontSize="19"/>

                    <Button x:Name="NotificationsNavButton"
                            Content="{x:Static properties:Strings.Settings_Nav_Notifications}"
                            Style="{StaticResource BtnOutline}"
                            Margin="0,0,0,8"
                            Click="NotificationsNavButton_Click"
                            FontSize="19"/>

                    <Button x:Name="PreferencesNavButton"
                            Content="{x:Static properties:Strings.Settings_Nav_Preferences}"
                            Style="{StaticResource BtnOutline}"
                            Margin="0,0,0,8"
                            Click="PreferencesNavButton_Click"
                            FontSize="19"/>

                    <Button x:Name="PrivacyNavButton"
                            Content="{x:Static properties:Strings.Settings_Nav_Privacy}"
                            Style="{StaticResource BtnOutline}"
                            Margin="0,0,0,20"
                            Click="PrivacyNavButton_Click"
                            FontSize="19"/>

                    <Border Height="1"
                            Background="{StaticResource BrushBorder}"
                            Margin="0,0,0,20"/>

                    <Button Content="{x:Static properties:Strings.Global_ButtonBack}"
                            Style="{StaticResource BtnBack}"
                            HorizontalAlignment="Stretch"
                            IsCancel="True"
                            Click="BackButton_Click"/>

                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardPanel}">

                <Grid>

                    <StackPanel x:Name="AccountPanel">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Account_Username}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock x:Name="AccountUsernameTextBlock"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{x:Static properties:Strings.Settings_ButtonChange}"
                                    Style="{StaticResource BtnOutline}"
                                    Padding="22,10"
                                    FontSize="19"/>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Account_Email}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{x:Static properties:Strings.Settings_ButtonChange}"
                                    Style="{StaticResource BtnOutline}"
                                    Padding="22,10"
                                    FontSize="19"/>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Foreground="{StaticResource BrushText}" Grid.Column="0"
                                       Text="{x:Static properties:Strings.Settings_Account_Avatar}"
                                       FontWeight="Bold"
                                       FontSize="22"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="{x:Static properties:Strings.Settings_Account_ButtonEditProfile}"
                                    Style="{StaticResource BtnPrimary}"
                                    Padding="22,11"
                                    FontSize="19"
                                    Click="EditProfileButton_Click"/>
                        </Grid>

                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel"
                                Visibility="Collapsed">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Appearance_DarkTheme}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Appearance_DarkThemeSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Border x:Name="DarkThemeToggle"
                                    Grid.Column="1"
                                    Width="46"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BrushBorder}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="DarkThemeToggle_Click">

                                <Border x:Name="DarkThemeToggleKnob"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0"/>

                            </Border>
                        </Grid>

                    </StackPanel>

                    <StackPanel x:Name="SecurityPanel"
                                Visibility="Collapsed">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Foreground="{StaticResource BrushText}" Grid.Column="0"
                                       Text="{x:Static properties:Strings.Settings_Security_Password}"
                                       FontWeight="Bold"
                                       FontSize="22"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="ChangePasswordToggleButton"
                                    Grid.Column="1"
                                    Content="{x:Static properties:Strings.Settings_ButtonChange}"
                                    Style="{StaticResource BtnOutline}"
                                    Padding="22,10"
                                    FontSize="18"
                                    Click="ChangePasswordToggleButton_Click"/>
                        </Grid>

                        <StackPanel x:Name="ChangePasswordPanel"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,16">

                            <TextBlock Text="{x:Static properties:Strings.Settings_Password_Current}"
                                       FontSize="16"
                                       Margin="0,0,0,6"
                                       Foreground="{StaticResource BrushTextMuted}"/>

                            <PasswordBox x:Name="CurrentPasswordBox"
                                         Style="{StaticResource PasswordBoxRounded}"
                                         Width="300"
                                         FontSize="18"
                                         Padding="12,9"
                                         Margin="0,0,0,12"
                                         HorizontalAlignment="Left"/>

                            <TextBlock Text="{x:Static properties:Strings.Settings_Password_New}"
                                       FontSize="16"
                                       Margin="0,0,0,6"
                                       Foreground="{StaticResource BrushTextMuted}"/>

                            <PasswordBox x:Name="NewPasswordBox"
                                         Style="{StaticResource PasswordBoxRounded}"
                                         Width="300"
                                         FontSize="18"
                                         Padding="12,9"
                                         Margin="0,0,0,12"
                                         HorizontalAlignment="Left"/>

                            <TextBlock Text="{x:Static properties:Strings.Settings_Password_Confirm}"
                                       FontSize="16"
                                       Margin="0,0,0,6"
                                       Foreground="{StaticResource BrushTextMuted}"/>

                            <PasswordBox x:Name="ConfirmNewPasswordBox"
                                         utils:EnterKeySubmit.Button="{Binding ElementName=SavePasswordButton}"
                                         Style="{StaticResource PasswordBoxRounded}"
                                         Width="300"
                                         FontSize="18"
                                         Padding="12,9"
                                         Margin="0,0,0,12"
                                         HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal">

                                <Button x:Name="SavePasswordButton"
                                        Content="{x:Static properties:Strings.Settings_Password_Save}"
                                        Style="{StaticResource BtnPrimary}"
                                        Padding="22,10"
                                        FontSize="18"
                                        Margin="0,0,12,0"
                                        Click="SavePasswordButton_Click"/>

                                <Button Content="{x:Static properties:Strings.Dialogs_ButtonCancel}"
                                        Style="{StaticResource BtnOutline}"
                                        Padding="22,10"
                                        FontSize="18"
                                        Click="ChangePasswordToggleButton_Click"/>

                            </StackPanel>
                        </StackPanel>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Security_TwoFactor}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Security_TwoFactorSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <PasswordBox x:Name="TwoFactorPasswordBox"
                                             utils:EnterKeySubmit.Button="{Binding ElementName=TwoFactorToggleButton}"
                                             Style="{StaticResource PasswordBoxRounded}"
                                             Width="240"
                                             FontSize="18"
                                             Margin="0,0,12,0"
                                             Padding="12,9"
                                             Visibility="Collapsed"
                                             ToolTip="{x:Static properties:Strings.Settings_Security_PasswordCurrent}"/>

                                <Button x:Name="TwoFactorToggleButton"
                                        Style="{StaticResource BtnOutline}"
                                        Padding="22,10"
                                        FontSize="18"
                                        IsEnabled="False"
                                        Click="TwoFactorToggleButton_Click"/>

                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,16,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">

                                <TextBlock Foreground="{StaticResource BrushText}"
                                           Text="{x:Static properties:Strings.Settings_Security_BackupCodes}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock x:Name="BackupCodesStatusTextBlock"
                                           Text="{x:Static properties:Strings.Settings_Security_BackupCodesOff}"
                                           FontSize="18"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Button x:Name="CreateBackupCodesButton"
                                    Grid.Column="1"
                                    Content="{x:Static properties:Strings.Settings_Security_ButtonBackupCodes}"
                                    Style="{StaticResource BtnOutline}"
                                    Padding="22,10"
                                    FontSize="18"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Click="CreateBackupCodesButton_Click"/>
                        </Grid>

                        <TextBox x:Name="BackupCodesTextBox"
                                 Style="{StaticResource TextBoxRounded}"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="18"
                                 Padding="12,9"
                                 Margin="0,12,0,0"/>

                    </StackPanel>

                    <StackPanel x:Name="NotificationsPanel"
                                Visibility="Collapsed">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Notifications_Match}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Notifications_MatchSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Border Width="46"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BrushFeltLight}"
                                    Grid.Column="1">

                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,3,0"/>

                            </Border>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Notifications_SoundsGame}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Notifications_SoundsGameSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Border x:Name="SoundsToggle"
                                    Width="46"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BrushFeltLight}"
                                    Cursor="Hand"
                                    Grid.Column="1"
                                    MouseLeftButtonUp="SoundsToggle_Click">

                                <Border x:Name="SoundsToggleKnob"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,3,0"/>

                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Audio_Music}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Audio_MusicSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Border x:Name="MusicToggle"
                                    Width="46"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BrushFeltLight}"
                                    Cursor="Hand"
                                    Grid.Column="1"
                                    MouseLeftButtonUp="MusicToggle_Click">

                                <Border x:Name="MusicToggleKnob"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,3,0"/>

                            </Border>
                        </Grid>

                        <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Audio_MusicVolume}"
                                   FontWeight="Bold"
                                   FontSize="22"
                                   Margin="0,20,0,6"/>

                        <Slider x:Name="MusicVolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                Width="320"
                                HorizontalAlignment="Left"
                                ValueChanged="MusicVolumeSlider_ValueChanged"/>

                    </StackPanel>

                    <StackPanel x:Name="PreferencesPanel"
                                Visibility="Collapsed">

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Foreground="{StaticResource BrushText}" Grid.Column="0"
                                       Text="{x:Static properties:Strings.Settings_Preferences_Language}"
                                       FontWeight="Bold"
                                       FontSize="22"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="LanguageComboBox"
                                      Grid.Column="1"
                                      Width="200"
                                      FontSize="20"
                                      Padding="12,9"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">

                                <ComboBoxItem Content="{x:Static properties:Strings.Settings_Preferences_OptionSpanish}"
                                              Tag="es-MX"/>

                                <ComboBoxItem Content="{x:Static properties:Strings.Settings_Preferences_OptionEnglish}"
                                              Tag="en-US"/>

                                <ComboBoxItem Content="{x:Static properties:Strings.Settings_Preferences_OptionPortuguese}"
                                              Tag="pt-BR"/>

                                <ComboBoxItem Content="{x:Static properties:Strings.Settings_Preferences_OptionChinese}"
                                              Tag="zh-CN"/>

                            </ComboBox>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Preferences_ShowPotentialPoints}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Preferences_ShowPotentialPointsSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Border Width="46"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BrushFeltLight}"
                                    Grid.Column="1">

                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,3,0"/>

                            </Border>
                        </Grid>

                    </StackPanel>

                    <StackPanel x:Name="PrivacyPanel"
                                Visibility="Collapsed">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Foreground="{StaticResource BrushText}" Text="{x:Static properties:Strings.Settings_Privacy_PublicProfile}"
                                           FontWeight="Bold"
                                           FontSize="22"/>

                                <TextBlock Text="{x:Static properties:Strings.Settings_Privacy_PublicProfileSub}"
                                           FontSize="18"
                                           Foreground="{StaticResource BrushTextMuted}"/>

                            </StackPanel>

                            <Border Width="46"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BrushFeltLight}"
                                    Grid.Column="1">

                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,3,0"/>

                            </Border>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="{x:Static properties:Strings.Settings_DeleteAccount_PasswordLabel}"
                                   FontSize="16"
                                   Margin="0,0,0,6"
                                   Foreground="{StaticResource BrushTextMuted}"/>

                        <PasswordBox x:Name="DeleteAccountPasswordBox"
                                     Style="{StaticResource PasswordBoxRounded}"
                                     Width="300"
                                     FontSize="18"
                                     Padding="12,9"
                                     Margin="0,0,0,12"
                                     HorizontalAlignment="Left"/>

                        <Button Content="{x:Static properties:Strings.Settings_Privacy_ButtonDeleteAccount}"
                                Style="{StaticResource BtnOutline}"
                                Foreground="{StaticResource BrushDanger}"
                                Padding="24,11"
                                FontSize="18"
                                HorizontalAlignment="Left"
                                Click="DeleteAccountButton_Click"/>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Viewbox>
</Window>