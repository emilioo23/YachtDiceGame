<Window x:Class="YachtDice.Views.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    
    <Window.Resources>
        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#48B8A6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#212121" BorderBrush="#48B8A6" BorderThickness="1.5" CornerRadius="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="#151515" CornerRadius="8,8,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
            
            <TextBlock Grid.Row="0" x:Name="TitleText" Foreground="#48B8A6" FontSize="14" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
            
            <Button Grid.Row="0" Content="✕" Foreground="#888888" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Width="30" Height="30"
                    FontSize="14" Click="SecondaryButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <TextBlock Grid.Row="1" x:Name="MessageText" Foreground="#ffffff" FontSize="14" 
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Margin="20,30,20,15"/>
                       
            <Button Grid.Row="2" x:Name="PrimaryButton" Content="Aceptar" Style="{StaticResource GameButtonStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="130" Height="38" 
                    Click="PrimaryButton_Click"/>
        </Grid>
    </Border>
</Window>
