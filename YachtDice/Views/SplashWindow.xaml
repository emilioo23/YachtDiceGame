<Window x:Class="YachtDice.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice"
        Width="1280" Height="720"
        MinWidth="800" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#14524A"
        Loaded="SplashWindow_Loaded"
        PreviewKeyDown="SplashWindow_ContinueRequested"
        PreviewMouseDown="SplashWindow_ContinueRequested">

    <Viewbox Stretch="Uniform">
        <Grid Width="1024" Height="574">

            <!-- Imagen de fondo original, sin tocar -->
            <Image x:Name="BaseImage"
                   Source="/Assets/SplashBackground.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Brillo pulsante sobre el titulo -->
            <Image x:Name="TitleGlowImage"
                   Source="/Assets/SplashBackground.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0">
                <Image.Effect>
                    <DropShadowEffect Color="#F2C230" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
                </Image.Effect>
            </Image>

            <!-- Brillo pulsante sobre el texto inferior -->
            <Image x:Name="HintGlowImage"
                   Source="/Assets/SplashBackground.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
                <Image.Effect>
                    <DropShadowEffect Color="White" Opacity="0.6" BlurRadius="18" ShadowDepth="0"/>
                </Image.Effect>
                <Image.RenderTransform>
                    <ScaleTransform x:Name="HintPulseScaleTransform" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>

        </Grid>
    </Viewbox>

    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="TitleGlowImage">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="TitleGlowImage"
                                      Storyboard.TargetProperty="Opacity"
                                      From="0" To="0.6" Duration="0:0:3" AutoReverse="True"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="HintGlowImage">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="HintGlowImage"
                                      Storyboard.TargetProperty="Opacity"
                                      From="0" To="0.17" Duration="0:0:1" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="HintPulseScaleTransform"
                                      Storyboard.TargetProperty="ScaleX"
                                      From="1" To="1.03" Duration="0:0:1.3" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="HintPulseScaleTransform"
                                      Storyboard.TargetProperty="ScaleY"
                                      From="1" To="1.03" Duration="0:0:1.5" AutoReverse="True"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

    </Window.Triggers>

</Window>