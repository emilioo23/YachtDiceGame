<Window x:Class="YachtDice.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Window.Resources>
        <RadialGradientBrush x:Key="BrushMesaFieltro" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#3D8A66" Offset="0"/>
            <GradientStop Color="#1E4A37" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="BrushAroMadera" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9C6B3E" Offset="0"/>
            <GradientStop Color="#5C3D24" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Margin="24" Width="1280" Height="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     Grid.Column="0" Grid.ColumnSpan="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <!-- ===================== IZQUIERDA: TABLA DE PUNTAJE ===================== -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
                <StackPanel>

                    <!-- TOPBAR: turno / ronda -->
                    <Border Background="{StaticResource BrushWood}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                        <Grid>
                            <TextBlock x:Name="TurnStatusTextBlock" Text="{x:Static properties:Strings.Game_YourTurnText}" Foreground="White" FontWeight="Bold" FontSize="19" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoundInfoTextBlock" Foreground="{StaticResource BrushCream2}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ENCABEZADOS DE JUGADORES -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource BrushWood}"
                                BorderBrush="{StaticResource BrushGold}" BorderThickness="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="PlayerInitialTextBlock" Text="U" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="PlayerNameTextBlock" Text="Tú" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource BrushFeltLight}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="2" HorizontalAlignment="Center">
                                <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DiegoL" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- FILAS DE CATEGORIAS (se generan por codigo) -->
                    <StackPanel x:Name="CategoriesPanel" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{x:Static properties:Strings.Game_HowToPlayButton}" Style="{StaticResource BtnOutline}"
                            HorizontalAlignment="Left" FontSize="15" Padding="16,8"/>
                        <Button Grid.Column="1" Content="{x:Static properties:Strings.Game_KickPlayerButton}"
                            Style="{StaticResource BtnOutline}" FontSize="15" Padding="10,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="{x:Static properties:Strings.Game_LeaveMatchButton}"
                            Style="{StaticResource BtnOutline}" Foreground="{StaticResource BrushDanger}"
                            FontSize="15" Padding="10,8" Click="LeaveMatchButton_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ===================== DERECHA: MESA DE DADOS ===================== -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- ARO DE MADERA -->
                    <Border Width="440" Height="440" CornerRadius="220" Background="{StaticResource BrushAroMadera}"
                        Effect="{StaticResource ShadowCard}" Margin="0,0,0,26">
                        <Border Width="380" Height="380" CornerRadius="190" Background="{StaticResource BrushMesaFieltro}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="DiceCanvas" Width="380" Height="380"/>
                        </Border>
                    </Border>

                    <Button x:Name="RollButton" Content="Tirar (0/3)" Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Center" FontSize="23" Padding="50,15" Margin="0,0,0,10"
                        Click="RollButton_Click"/>

                    <TextBlock x:Name="HintTextBlock" Text="{x:Static properties:Strings.Game_PressRollHint}"
                           FontSize="12" Foreground="{StaticResource BrushCream2}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="Finalizar partida (demo)" FontSize="11" Foreground="{StaticResource BrushCream2}"
                           HorizontalAlignment="Center" TextDecorations="Underline" Cursor="Hand"
                           MouseLeftButtonUp="FinishDemoLink_Click"/>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>
