<Window x:Class="YachtDice.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}" Height="690" Width="508"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontBody}">

    <Grid>
        <views:LanguageSwitcher x:Name="LanguageSwitcherControl" HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,16,16,0"
                                 Panel.ZIndex="99"/>

        <Border Style="{StaticResource CardPanel}" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock Text="{x:Static properties:Strings.ResetPassword_Title}"
                           FontFamily="{StaticResource FontBodySemibold}"
                           FontSize="23" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static properties:Strings.ResetPassword_Subtitle}"
                           FontSize="15"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="EmailTextBlock"
                           FontFamily="{StaticResource FontBodySemibold}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <TextBlock Text="{x:Static properties:Strings.ResetPassword_Code}"
                           Style="{StaticResource FieldLabel}"
                           FontSize="14"/>
                <TextBox x:Name="CodeTextBox"
                         Style="{StaticResource TextBoxRounded}"
                         FontSize="20" TextAlignment="Center"
                         Margin="0,0,0,16"
                         PreviewTextInput="CodeTextBox_PreviewTextInput"/>

                <TextBlock Text="{x:Static properties:Strings.ResetPassword_NewPassword}"
                           Style="{StaticResource FieldLabel}"
                           FontSize="14"/>
                <views:PasswordRevealBox x:Name="NewPasswordBox"
                                         Margin="0,0,0,16"/>

                <TextBlock Text="{x:Static properties:Strings.ResetPassword_ConfirmPassword}"
                           Style="{StaticResource FieldLabel}"
                           FontSize="14"/>
                <views:PasswordRevealBox x:Name="ConfirmPasswordBox"
                                         Margin="0,0,0,20"/>

                <Button x:Name="ChangePasswordButton"
                        Content="{x:Static properties:Strings.ResetPassword_ButtonChange}"
                        Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch"
                        FontSize="15" Padding="0,13"
                        Margin="0,0,0,16"
                        Click="ChangePasswordButton_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="{x:Static properties:Strings.ResetPassword_ResendText}"
                               FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static properties:Strings.ResetPassword_LinkResend}"
                               Style="{StaticResource LinkText}"
                               MouseLeftButtonUp="ResendLink_Click"
                               FontSize="14"/>
                </StackPanel>

                <TextBlock Text="{x:Static properties:Strings.ForgotPassword_LinkBackToLogin}"
                           Style="{StaticResource LinkText}"
                           HorizontalAlignment="Center"
                           MouseLeftButtonUp="BackToLoginLink_Click"
                           FontSize="15"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
