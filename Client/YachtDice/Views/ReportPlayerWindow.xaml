<Window x:Class="YachtDice.Views.ReportPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        Title="{x:Static properties:Strings.Report_ButtonReport}" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border Background="{DynamicResource BrushCardBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1.5" CornerRadius="10" Margin="35"
            Effect="{DynamicResource ShadowCard}">
        <StackPanel>

            <Border Background="{DynamicResource BrushCream2}" CornerRadius="8,8,0,0" Height="45"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleTextBlock" Foreground="{DynamicResource BrushGold}"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Border>

            <StackPanel Margin="24,20,24,10">

                <TextBlock Text="{x:Static properties:Strings.Report_ReasonLabel}"
                           FontSize="14" Margin="0,0,0,6"
                           Foreground="{DynamicResource BrushTextMuted}"/>

                <ComboBox x:Name="ReasonComboBox"
                          FontSize="14"
                          Padding="10,7"
                          Margin="0,0,0,14"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"/>

                <TextBlock Text="{x:Static properties:Strings.Report_CommentLabel}"
                           FontSize="14" Margin="0,0,0,6"
                           Foreground="{DynamicResource BrushTextMuted}"/>

                <TextBox x:Name="CommentTextBox"
                         Style="{DynamicResource TextBoxRounded}"
                         FontSize="14"
                         Padding="10,8"
                         Height="90"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,24">

                <Button x:Name="SendButton"
                        Content="{x:Static properties:Strings.Report_ButtonSend}"
                        Style="{DynamicResource BtnPrimary}" MinWidth="150"
                        Click="SendButton_Click"/>

                <Button Content="{x:Static properties:Strings.Dialogs_ButtonCancel}"
                        Style="{DynamicResource BtnOutline}"
                        IsCancel="True"
                        MinWidth="130" Margin="12,0,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
