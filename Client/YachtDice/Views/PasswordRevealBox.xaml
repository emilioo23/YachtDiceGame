<UserControl x:Class="YachtDice.Views.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:YachtDice.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="300">

    <Grid>

        <PasswordBox x:Name="HiddenPasswordBox"
                     Style="{StaticResource PasswordBoxRounded}"
                     FontSize="16"
                     Padding="10,8,46,8"/>

        <TextBox x:Name="VisiblePasswordBox"
                 Style="{StaticResource TextBoxRounded}"
                 FontSize="16"
                 Padding="10,8,46,8"
                 Visibility="Collapsed"/>

        <Button x:Name="RevealButton"
                Width="34"
                Height="34"
                Margin="0,0,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="Hand"
                Focusable="False"
                ToolTip="{x:Static properties:Strings.Auth_ShowPassword}"
                Click="RevealButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconBorder"
                            Background="Transparent"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="{StaticResource BrushCream2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <Viewbox Width="20"
                     Height="20">

                <Canvas Width="24"
                        Height="24">

                    <Path Data="M1,12 C4,6 8,4 12,4 C16,4 20,6 23,12 C20,18 16,20 12,20 C8,20 4,18 1,12 Z"
                          Stroke="{StaticResource BrushTextMuted}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"/>

                    <Ellipse Canvas.Left="8.5"
                             Canvas.Top="8.5"
                             Width="7"
                             Height="7"
                             Stroke="{StaticResource BrushTextMuted}"
                             StrokeThickness="2"/>

                    <Line x:Name="SlashLine"
                          X1="3"
                          Y1="21"
                          X2="21"
                          Y2="3"
                          Stroke="{StaticResource BrushTextMuted}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed"/>
                </Canvas>
            </Viewbox>
        </Button>

    </Grid>
</UserControl>
