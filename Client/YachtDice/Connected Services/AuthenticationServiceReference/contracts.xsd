<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="urn:yachtdice:contracts" elementFormDefault="qualified" targetNamespace="urn:yachtdice:contracts" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Login">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="request" nillable="true" type="tns:LoginRequestDto" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="LoginRequestDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="CultureName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Password" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LoginRequestDto" nillable="true" type="tns:LoginRequestDto" />
  <xs:element name="LoginResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="LoginResult" nillable="true" type="tns:LoginResponseDto" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="LoginResponseDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:LoginResultCode" />
      <xs:element minOccurs="0" name="DisplayName" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LoginResponseDto" nillable="true" type="tns:LoginResponseDto" />
  <xs:simpleType name="LoginResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="VerificationCodeSent" />
      <xs:enumeration value="MissingRequiredField" />
      <xs:enumeration value="InvalidCredentials" />
      <xs:enumeration value="VerificationLocked" />
      <xs:enumeration value="CodeSendFailed" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="LoginResultCode" nillable="true" type="tns:LoginResultCode" />
  <xs:complexType name="ServiceFault">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:ServiceErrorCode" />
      <xs:element minOccurs="0" name="Message" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ServiceFault" nillable="true" type="tns:ServiceFault" />
  <xs:simpleType name="ServiceErrorCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UnexpectedError" />
      <xs:enumeration value="DatabaseUnavailable" />
      <xs:enumeration value="InvalidRequest" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ServiceErrorCode" nillable="true" type="tns:ServiceErrorCode" />
  <xs:element name="Register">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="request" nillable="true" type="tns:RegisterRequestDto" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="RegisterRequestDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="FirstName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="LastName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Password" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RegisterRequestDto" nillable="true" type="tns:RegisterRequestDto" />
  <xs:element name="RegisterResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="RegisterResult" type="tns:RegisterResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="RegisterResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Success" />
      <xs:enumeration value="MissingRequiredField" />
      <xs:enumeration value="FieldTooLong" />
      <xs:enumeration value="InvalidEmail" />
      <xs:enumeration value="EmailAlreadyRegistered" />
      <xs:enumeration value="UsernameAlreadyTaken" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="RegisterResultCode" nillable="true" type="tns:RegisterResultCode" />
  <xs:element name="VerifyCode">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="request" nillable="true" type="tns:VerifyCodeRequestDto" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="VerifyCodeRequestDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="VerifyCodeRequestDto" nillable="true" type="tns:VerifyCodeRequestDto" />
  <xs:element name="VerifyCodeResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="VerifyCodeResult" type="tns:VerificationResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="VerificationResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Valid" />
      <xs:enumeration value="Incorrect" />
      <xs:enumeration value="Expired" />
      <xs:enumeration value="Locked" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="VerificationResultCode" nillable="true" type="tns:VerificationResultCode" />
  <xs:element name="ResendCode">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="request" nillable="true" type="tns:ResendCodeRequestDto" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="ResendCodeRequestDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="CultureName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ResendCodeRequestDto" nillable="true" type="tns:ResendCodeRequestDto" />
  <xs:element name="ResendCodeResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="ResendCodeResult" type="tns:ResendResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="ResendResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CodeSent" />
      <xs:enumeration value="ResendTooSoon" />
      <xs:enumeration value="VerificationLocked" />
      <xs:enumeration value="CodeSendFailed" />
      <xs:enumeration value="PlayerNotFound" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ResendResultCode" nillable="true" type="tns:ResendResultCode" />
</xs:schema>