<UserControl x:Class="YachtDice.Views.LanguageSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:YachtDice.Resources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <ToggleButton x:Name="LanguageToggleButton"
                      Click="LanguageToggleButton_Click"
                      Background="#FAF7F0"
                      BorderThickness="0"
                      Padding="10,5"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,6,0" ClipToBounds="True">
                    <Image x:Name="CurrentFlagImage" Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="CurrentLangText"
                           FontFamily="Oswald"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#2d6a4f"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static properties:Strings.Global_SymbolDropdown}" Margin="6,0,0,0" FontSize="16" Foreground="#2d6a4f" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="LanguagePopup"
               PlacementTarget="{Binding ElementName=LanguageToggleButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               VerticalOffset="6">
            <Border Background="#FAF7F0"
                    CornerRadius="10"
                    Padding="4"
                    BorderBrush="#d4a017"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Width="140">
                    <Button Tag="es-MX"
                            Click="LanguageOptionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,8,0" ClipToBounds="True">
                                <Image Source="/Resources/Flags/es.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{x:Static properties:Strings.Settings_Preferences_OptionSpanish}" FontFamily="Inter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="en-US"
                            Click="LanguageOptionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,8,0" ClipToBounds="True">
                                <Image Source="/Resources/Flags/us.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{x:Static properties:Strings.Settings_Preferences_OptionEnglish}" FontFamily="Inter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="pt-BR"
                            Click="LanguageOptionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,8,0" ClipToBounds="True">
                                <Image Source="/Resources/Flags/br.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{x:Static properties:Strings.Settings_Preferences_OptionPortuguese}" FontFamily="Inter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="zh-CN"
                            Click="LanguageOptionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,8,0" ClipToBounds="True">
                                <Image Source="/Resources/Flags/cn.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{x:Static properties:Strings.Settings_Preferences_OptionChinese}" FontFamily="Inter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
