<Window x:Class="YachtDice.Views.TwoFactorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Yacht Dice" Height="536" Width="457"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontBody}">

    <Grid>
        <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,16,16,0"
                                 Panel.ZIndex="99"/>

        <Border Style="{StaticResource CardPanel}" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock Text="{x:Static properties:Strings.TwoFactor_Title}"
                           FontFamily="{StaticResource FontBodySemibold}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushFeltLight}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="{x:Static properties:Strings.TwoFactor_Subtitle}"
                           FontSize="15"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="DestinationEmailTextBlock"
                           Text="{Binding TODO_Propiedad}" d:Text="usuario@ejemplo.com"
                           FontFamily="{StaticResource FontBodySemibold}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <!-- 4 CASILLAS DE CODIGO -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Digit1" Grid.Column="0" Margin="4,0" Style="{StaticResource TextBoxRounded}"
                             MaxLength="1" FontSize="22" TextAlignment="Center" Height="56"
                             TextChanged="Digit_TextChanged"/>
                    <TextBox x:Name="Digit2" Grid.Column="1" Margin="4,0" Style="{StaticResource TextBoxRounded}"
                             MaxLength="1" FontSize="22" TextAlignment="Center" Height="56"
                             TextChanged="Digit_TextChanged"/>
                    <TextBox x:Name="Digit3" Grid.Column="2" Margin="4,0" Style="{StaticResource TextBoxRounded}"
                             MaxLength="1" FontSize="22" TextAlignment="Center" Height="56"
                             TextChanged="Digit_TextChanged"/>
                    <TextBox x:Name="Digit4" Grid.Column="3" Margin="4,0" Style="{StaticResource TextBoxRounded}"
                             MaxLength="1" FontSize="22" TextAlignment="Center" Height="56"
                             TextChanged="Digit_TextChanged"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="{x:Static properties:Strings.TwoFactor_ResendText}"
                               FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static properties:Strings.TwoFactor_ResendLink}"
                               Style="{StaticResource LinkText}"
                               MouseLeftButtonUp="ResendLink_Click"
                               FontSize="14"/>
                </StackPanel>

                <Button x:Name="VerifyButton"
                        Content="{x:Static properties:Strings.TwoFactor_VerifyButton}"
                        Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch"
                        FontSize="16" Padding="0,13"
                        Margin="0,0,0,14"
                        Click="VerifyButton_Click"/>

                <TextBlock Text="{x:Static properties:Strings.TwoFactor_BackLink}"
                           Style="{StaticResource LinkText}"
                           HorizontalAlignment="Center"
                           MouseLeftButtonUp="BackLink_Click"
                           FontSize="15"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
