<Window x:Class="YachtDice.Views.RoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YachtDice.Views"
        xmlns:res="clr-namespace:YachtDice.Resources"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static res:Strings.Auth_Logo}"
        Height="800"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1000"
              Height="800">

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Border Style="{StaticResource CardPanel}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{x:Static res:Strings.Rooms_Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="33"
                               Foreground="{StaticResource BrushText}"
                               Margin="0,0,0,6"/>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{x:Static res:Strings.Global_ButtonBack}"
                                Style="{StaticResource BtnBack}"
                                VerticalAlignment="Center"
                                Click="BackButton_Click"/>

                        <Button x:Name="RefreshButton"
                                Grid.Column="1"
                                Content="{x:Static res:Strings.Rooms_ButtonRefresh}"
                                Style="{StaticResource BtnOutline}"
                                Padding="18,8"
                                FontSize="15"
                                Click="RefreshButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,14,0">

                            <TextBlock Text="{x:Static res:Strings.Rooms_FilterSearchLabel}"
                                       Style="{StaticResource FieldLabel}"
                                       FontSize="15"/>

                            <TextBox x:Name="SearchTextBox"
                                     Style="{StaticResource TextBoxRounded}"
                                     ToolTip="{x:Static res:Strings.Rooms_FilterSearchHint}"
                                     MaxLength="40"
                                     FontSize="16"
                                     Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Width="220">

                            <TextBlock Text="{x:Static res:Strings.Rooms_FilterPrivacyLabel}"
                                       Style="{StaticResource FieldLabel}"
                                       FontSize="15"/>

                            <ComboBox x:Name="PrivacyFilterComboBox"
                                      Padding="10,8"
                                      FontSize="17"
                                      SelectedIndex="0">

                                <ComboBoxItem x:Name="AllFilterItem"
                                              Content="{x:Static res:Strings.Rooms_FilterAll}"/>
                                <ComboBoxItem x:Name="PublicFilterItem"
                                              Content="{x:Static res:Strings.Rooms_FilterPublic}"/>
                                <ComboBoxItem x:Name="PrivateFilterItem"
                                              Content="{x:Static res:Strings.Rooms_FilterPrivate}"/>

                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EmptyTextBlock"
                               Grid.Row="3"
                               Text="{x:Static res:Strings.Rooms_Empty}"
                               FontSize="17"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextMuted}"
                               Visibility="Collapsed"/>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="RoomsItemsControl">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushCream2}"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    Background="{StaticResource BrushWood}"
                                                    Margin="0,0,14,0">

                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="19"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="17"
                                                           Foreground="{StaticResource BrushText}"/>

                                                <TextBlock Text="{Binding Details}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource BrushTextMuted}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PrivacyText}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushFeltLight}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"/>

                                            <TextBox Grid.Column="3"
                                                     Text="{Binding AccessCode, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{x:Static res:Strings.Rooms_CodeHint}"
                                                     Style="{StaticResource TextBoxRounded}"
                                                     Visibility="{Binding IsPrivate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Width="120"
                                                     MaxLength="6"
                                                     FontSize="15"
                                                     Margin="0,0,12,0"
                                                     VerticalAlignment="Center"/>

                                            <Button Grid.Column="4"
                                                    Content="{x:Static res:Strings.Rooms_ButtonJoin}"
                                                    Style="{StaticResource BtnPrimary}"
                                                    IsEnabled="{Binding HasSpace}"
                                                    Padding="22,9"
                                                    FontSize="15"
                                                    VerticalAlignment="Center"
                                                    Click="JoinButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
