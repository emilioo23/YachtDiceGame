<Window x:Class="YachtDice.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}"
        Height="800"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1100"
              Height="800">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Border Grid.Column="0"
                    Style="{StaticResource CardPanel}"
                    Margin="0,0,16,0">

                <StackPanel>

                    <TextBlock Text="{x:Static properties:Strings.Profile_ChooseAvatar}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,16"/>

                    <Grid Width="120"
                          Height="120"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,12">
                        <Border CornerRadius="60"
                                Background="{StaticResource BrushCream2}"
                                BorderBrush="{StaticResource BrushGold}"
                                BorderThickness="3">
                            <Image x:Name="AvatarPreviewImage"
                                   Margin="3"/>
                        </Border>
                        <Image x:Name="FlagPreviewImage"
                               Width="40"
                               Height="30"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-6,-18,0"
                               Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock x:Name="TitlePreviewTextBlock"
                               FontSize="16"
                               FontStyle="Italic"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushGold}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="LevelTextBlock"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ItemsControl x:Name="AvatarOptionsItemsControl"
                                  Margin="0,0,0,20">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="3"
                                        CornerRadius="30"
                                        BorderThickness="3"
                                        Background="Transparent"
                                        Tag="{Binding Id}"
                                        MouseLeftButtonUp="AvatarOption_Click">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="Cursor"
                                                    Value="Hand"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource BrushGold}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUnlocked}"
                                                             Value="False">
                                                    <Setter Property="Cursor"
                                                            Value="Arrow"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Image Width="46"
                                               Height="46"
                                               Source="{Binding Id, Converter={StaticResource AvatarImageConverter}}">

                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}"
                                                                     Value="False">
                                                            <Setter Property="Opacity"
                                                                    Value="0.35"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Border Background="{StaticResource BrushWoodDark}"
                                                CornerRadius="8"
                                                Padding="5,1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}"
                                                                     Value="False">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding RequiredLevel,
                                                StringFormat={x:Static properties:Strings.Profile_AvatarLockedBadge}}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardPanel}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,20">

                        <TextBlock Text="{x:Static properties:Strings.Profile_CustomizeProfileTitle}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="26"
                                   Foreground="{StaticResource BrushText}"/>

                        <Button Content="{x:Static properties:Strings.Global_ButtonBack}"
                                Style="{StaticResource BtnOutline}"
                                HorizontalAlignment="Right"
                                Padding="14,6"
                                FontSize="18"
                                Click="BackButton_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">

                    <TextBlock Text="{x:Static properties:Strings.Profile_Username}"
                               Style="{StaticResource FieldLabel}"
                               FontSize="18"/>

                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource TextBoxRounded}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{x:Static properties:Strings.Profile_TitleLabel}"
                               Style="{StaticResource FieldLabel}"
                               FontSize="18"/>

                    <ComboBox x:Name="TitleComboBox"
                              Padding="10,8"
                              FontSize="17"
                              Margin="0,0,0,24"
                              SelectionChanged="TitleComboBox_SelectionChanged"/>

                    <TextBlock Text="{x:Static properties:Strings.Profile_FlagLabel}"
                               Style="{StaticResource FieldLabel}"
                               FontSize="18"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Margin="0,0,10,0">
                            <TextBox x:Name="FlagSearchTextBox"
                                     Style="{StaticResource TextBoxRounded}"
                                     FontSize="17"
                                     TextChanged="FlagSearchTextBox_TextChanged"/>
                            <TextBlock x:Name="FlagSearchHintTextBlock"
                                       Text="{x:Static properties:Strings.Profile_FlagSearchHint}"
                                       FontSize="17"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0"/>
                        </Grid>

                        <ComboBox x:Name="FlagComboBox"
                                  Grid.Column="1"
                                  Padding="10,8"
                                  FontSize="17"
                                  VerticalAlignment="Center"
                                  SelectionChanged="FlagComboBox_SelectionChanged"/>
                    </Grid>
                    <TextBlock Text="{x:Static properties:Strings.Profile_StatisticsHeader}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,10"/>

                    <Border Background="{StaticResource BrushCream2}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Margin="0,0,0,24">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock x:Name="StatGamesValueTextBlock"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_StatGames}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock x:Name="StatWinsValueTextBlock"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_StatWins}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock x:Name="StatBestScoreValueTextBlock"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_StatBestScore}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        Margin="0,14">

                                <TextBlock x:Name="StatExperienceValueTextBlock"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="23"
                                           Foreground="{StaticResource BrushFeltLight}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{x:Static properties:Strings.Profile_TotalXp}"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="AchievementsHeaderTextBlock"
                               Text="{x:Static properties:Strings.Profile_Achievements_Header}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,10"/>

                    <WrapPanel x:Name="AchievementsWrapPanel"
                               Margin="0,0,0,8"/>

                    </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="{x:Static properties:Strings.Profile_ButtonSaveChanges}"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            Padding="0,13"
                            Margin="0,16,0,0"
                            Click="SaveChangesButton_Click"/>

                </Grid>
            </Border>

        </Grid>
    </Viewbox>
</Window>