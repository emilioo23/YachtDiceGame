<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="urn:yachtdice:contracts" elementFormDefault="qualified" targetNamespace="urn:yachtdice:contracts" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="IsTwoFactorEnabled">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="IsTwoFactorEnabledResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="IsTwoFactorEnabledResult" type="xs:boolean" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="ServiceFault">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:ServiceErrorCode" />
      <xs:element minOccurs="0" name="Message" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ServiceFault" nillable="true" type="tns:ServiceFault" />
  <xs:simpleType name="ServiceErrorCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UnexpectedError" />
      <xs:enumeration value="DatabaseUnavailable" />
      <xs:enumeration value="ValidationFailed" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ServiceErrorCode" nillable="true" type="tns:ServiceErrorCode" />
  <xs:element name="StartTwoFactorActivation">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="culture" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="StartTwoFactorActivationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="StartTwoFactorActivationResult" nillable="true" type="tns:TwoFactorActivationData" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="TwoFactorActivationData">
    <xs:sequence>
      <xs:element minOccurs="0" name="ChallengeId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Code" type="tns:TwoFactorActivationResultCode" />
      <xs:element minOccurs="0" name="MaskedEmail" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="TwoFactorActivationData" nillable="true" type="tns:TwoFactorActivationData" />
  <xs:simpleType name="TwoFactorActivationResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CodeSent" />
      <xs:enumeration value="PlayerNotFound" />
      <xs:enumeration value="AlreadyEnabled" />
      <xs:enumeration value="VerificationLocked" />
      <xs:enumeration value="CodeSendFailed" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="TwoFactorActivationResultCode" nillable="true" type="tns:TwoFactorActivationResultCode" />
  <xs:element name="ConfirmTwoFactorActivation">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="code" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="challengeId" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ConfirmTwoFactorActivationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="ConfirmTwoFactorActivationResult" type="tns:VerificationResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="VerificationResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Valid" />
      <xs:enumeration value="Incorrect" />
      <xs:enumeration value="Expired" />
      <xs:enumeration value="Locked" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="VerificationResultCode" nillable="true" type="tns:VerificationResultCode" />
  <xs:element name="ResendActivationCode">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="challengeId" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="culture" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ResendActivationCodeResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="ResendActivationCodeResult" type="tns:ResendResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="ResendResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CodeSent" />
      <xs:enumeration value="ResendTooSoon" />
      <xs:enumeration value="VerificationLocked" />
      <xs:enumeration value="CodeSendFailed" />
      <xs:enumeration value="PlayerNotFound" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ResendResultCode" nillable="true" type="tns:ResendResultCode" />
  <xs:element name="DisableTwoFactor">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="password" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DisableTwoFactorResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="DisableTwoFactorResult" type="tns:TwoFactorChangeResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="TwoFactorChangeResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Success" />
      <xs:enumeration value="InvalidPassword" />
      <xs:enumeration value="PlayerNotFound" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="TwoFactorChangeResultCode" nillable="true" type="tns:TwoFactorChangeResultCode" />
</xs:schema>