<Window x:Class="YachtDice.Views.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diálogo" Height="800" Width="1280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="#99000000"
        ShowInTaskbar="False"
        FontFamily="{StaticResource FontBody}">

    <Grid>
        <Border Style="{StaticResource CardPanel}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                
                <TextBlock x:Name="TitleTextBlock" 
                           Text="Atención"
                           FontFamily="{StaticResource FontDisplay}" 
                           FontSize="28" 
                           Foreground="{StaticResource BrushWoodDark}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,16"/>

                <TextBlock x:Name="MessageTextBlock" 
                           Text="Este es el mensaje del diálogo."
                           FontSize="16" 
                           Foreground="{StaticResource BrushTextMuted}"
                           TextWrapping="Wrap" 
                           TextAlignment="Center"
                           Margin="0,0,0,32"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SecondaryButton" 
                            Grid.Column="0" 
                            Content="Cancelar" 
                            Style="{StaticResource BtnOutline}" 
                            FontSize="16" Padding="0,12"
                            Click="SecondaryButtonClick"/>

                    <Button x:Name="PrimaryButton" 
                            Grid.Column="2" 
                            Content="Aceptar" 
                            Style="{StaticResource BtnPrimary}" 
                            FontSize="16" Padding="0,12"
                            Click="PrimaryButtonClick"/>
                </Grid>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>