<Window x:Class="YachtDice.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YachtDice.Views"
        xmlns:res="clr-namespace:YachtDice.Resources"
        Title="{x:Static res:Strings.Auth_Logo}"
        Height="800"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">
    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1000"
              Height="800">
            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>
            <Border Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static res:Strings.History_Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="33"
                               Foreground="{StaticResource BrushText}"/>
                    <Button DockPanel.Dock="Top"
                            Content="{x:Static res:Strings.Global_ButtonBack}"
                            Style="{StaticResource BtnBack}"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,16"
                            Click="BackButton_Click"/>
                    <TextBlock x:Name="EmptyTextBlock"
                               DockPanel.Dock="Top"
                               Text="{x:Static res:Strings.History_Empty}"
                               FontSize="18"
                               Foreground="{StaticResource BrushTextMuted}"
                               Visibility="Collapsed"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            CornerRadius="10"
                                            BorderThickness="0,0,0,0"
                                            Background="{StaticResource BrushCream2}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="10,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource BrushDanger}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWin}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource BrushFeltLight}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="16,12"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ResultText}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushText}"/>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource BrushTextMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding OpponentsText}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource BrushText}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ScoreText}"
                                                       FontFamily="{StaticResource FontDisplay}"
                                                       FontSize="26"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource BrushText}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Viewbox>
</Window>
