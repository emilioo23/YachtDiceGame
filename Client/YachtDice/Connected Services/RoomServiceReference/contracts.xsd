<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="urn:yachtdice:contracts" elementFormDefault="qualified" targetNamespace="urn:yachtdice:contracts" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="CreateRoom">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="CreateRoomResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="CreateRoomResult" nillable="true" type="tns:CreateRoomResult" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="CreateRoomResult">
    <xs:sequence>
      <xs:element minOccurs="0" name="PlayerId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Room" nillable="true" type="tns:RoomState" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="CreateRoomResult" nillable="true" type="tns:CreateRoomResult" />
  <xs:complexType name="RoomState">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="HostId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Players" nillable="true" type="tns:ArrayOfRoomPlayer" />
      <xs:element minOccurs="0" name="Settings" nillable="true" type="tns:RoomSettings" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RoomState" nillable="true" type="tns:RoomState" />
  <xs:complexType name="ArrayOfRoomPlayer">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="RoomPlayer" nillable="true" type="tns:RoomPlayer" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfRoomPlayer" nillable="true" type="tns:ArrayOfRoomPlayer" />
  <xs:complexType name="RoomPlayer">
    <xs:sequence>
      <xs:element minOccurs="0" name="DisplayName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Id" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RoomPlayer" nillable="true" type="tns:RoomPlayer" />
  <xs:complexType name="RoomSettings">
    <xs:sequence>
      <xs:element minOccurs="0" name="IsPrivate" type="xs:boolean" />
      <xs:element minOccurs="0" name="MaxPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="Speed" type="tns:GameSpeed" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RoomSettings" nillable="true" type="tns:RoomSettings" />
  <xs:simpleType name="GameSpeed">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Normal" />
      <xs:enumeration value="Fast" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="GameSpeed" nillable="true" type="tns:GameSpeed" />
  <xs:complexType name="ServiceFault">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:ServiceErrorCode" />
      <xs:element minOccurs="0" name="Message" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ServiceFault" nillable="true" type="tns:ServiceFault" />
  <xs:simpleType name="ServiceErrorCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UnexpectedError" />
      <xs:enumeration value="DatabaseUnavailable" />
      <xs:enumeration value="ValidationFailed" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ServiceErrorCode" nillable="true" type="tns:ServiceErrorCode" />
  <xs:element name="JoinRoom">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="roomCode" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="JoinRoomResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="JoinRoomResult" nillable="true" type="tns:JoinRoomResult" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="JoinRoomResult">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:RoomResultCode" />
      <xs:element minOccurs="0" name="PlayerId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Room" nillable="true" type="tns:RoomState" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="JoinRoomResult" nillable="true" type="tns:JoinRoomResult" />
  <xs:simpleType name="RoomResultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Success" />
      <xs:enumeration value="RoomNotFound" />
      <xs:enumeration value="RoomFull" />
      <xs:enumeration value="GameAlreadyStarted" />
      <xs:enumeration value="NotHost" />
      <xs:enumeration value="NotEnoughPlayers" />
      <xs:enumeration value="InvalidSettings" />
      <xs:enumeration value="InvalidAccessCode" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="RoomResultCode" nillable="true" type="tns:RoomResultCode" />
  <xs:element name="GetRoomList">
    <xs:complexType>
      <xs:sequence />
    </xs:complexType>
  </xs:element>
  <xs:element name="GetRoomListResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="GetRoomListResult" nillable="true" type="tns:ArrayOfRoomSummary" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="ArrayOfRoomSummary">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="RoomSummary" nillable="true" type="tns:RoomSummary" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfRoomSummary" nillable="true" type="tns:ArrayOfRoomSummary" />
  <xs:complexType name="RoomSummary">
    <xs:sequence>
      <xs:element minOccurs="0" name="HostName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="IsPrivate" type="xs:boolean" />
      <xs:element minOccurs="0" name="MaxPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="PlayerCount" type="xs:int" />
      <xs:element minOccurs="0" name="RoomId" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Speed" type="tns:GameSpeed" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RoomSummary" nillable="true" type="tns:RoomSummary" />
  <xs:element name="JoinListedRoom">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="displayName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="roomId" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="accessCode" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="JoinListedRoomResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="JoinListedRoomResult" nillable="true" type="tns:JoinRoomResult" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="UpdateRoomSettings">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="playerId" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="roomCode" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="settings" nillable="true" type="tns:RoomSettings" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="UpdateRoomSettingsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="UpdateRoomSettingsResult" type="tns:RoomResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="StartGame">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="playerId" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="roomCode" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="StartGameResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="StartGameResult" type="tns:RoomResultCode" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="LeaveRoom">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="playerId" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="roomCode" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="LeaveRoomResponse">
    <xs:complexType>
      <xs:sequence />
    </xs:complexType>
  </xs:element>
  <xs:element name="RoomChanged">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="room" nillable="true" type="tns:RoomState" />
        <xs:element minOccurs="0" name="eventType" type="tns:RoomEventType" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="RoomEventType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PlayerJoined" />
      <xs:enumeration value="PlayerLeft" />
      <xs:enumeration value="SettingsChanged" />
      <xs:enumeration value="GameStarted" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="RoomEventType" nillable="true" type="tns:RoomEventType" />
</xs:schema>