<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!--  PALETA DE COLORES — Yacht Dice (TEMA OSCURO)                  -->
    <!-- ============================================================ -->
    <Color x:Key="ColFeltLight">#3ECF8E</Color>
    <Color x:Key="ColFeltMid">#1E2124</Color>
    <Color x:Key="ColFeltDark">#15171A</Color>
    <Color x:Key="ColCream">#2B2D31</Color>
    <Color x:Key="ColCream2">#313338</Color>
    <Color x:Key="ColWood">#3F4248</Color>
    <Color x:Key="ColWoodDark">#E3C08B</Color>
    <Color x:Key="ColGold">#F0B90B</Color>
    <Color x:Key="ColGoldLight">#FFD24C</Color>
    <Color x:Key="ColGoldDark">#B4870A</Color>
    <Color x:Key="ColText">#F2F3F5</Color>
    <Color x:Key="ColTextMuted">#96989D</Color>
    <Color x:Key="ColDanger">#FF7A6B</Color>
    <Color x:Key="ColBorder">#3F4147</Color>
    <Color x:Key="ColWhite">#FFFFFF</Color>

    <SolidColorBrush x:Key="BrushFeltLight" Color="{StaticResource ColFeltLight}"/>
    <SolidColorBrush x:Key="BrushFeltDark"  Color="{StaticResource ColFeltDark}"/>
    <SolidColorBrush x:Key="BrushCream"     Color="{StaticResource ColCream}"/>
    <SolidColorBrush x:Key="BrushCream2"    Color="{StaticResource ColCream2}"/>
    <SolidColorBrush x:Key="BrushWood"      Color="{StaticResource ColWood}"/>
    <SolidColorBrush x:Key="BrushWoodDark"  Color="{StaticResource ColWoodDark}"/>
    <SolidColorBrush x:Key="BrushGold"      Color="{StaticResource ColGold}"/>
    <SolidColorBrush x:Key="BrushGoldDark"  Color="{StaticResource ColGoldDark}"/>
    <SolidColorBrush x:Key="BrushText"      Color="{StaticResource ColText}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}"/>
    <SolidColorBrush x:Key="BrushDanger"    Color="{StaticResource ColDanger}"/>
    <SolidColorBrush x:Key="BrushBorder"    Color="{StaticResource ColBorder}"/>
    <SolidColorBrush x:Key="BrushWhite"     Color="{StaticResource ColWhite}"/>

    <RadialGradientBrush x:Key="BrushFeltBackground" Center="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="{StaticResource ColFeltMid}"   Offset="0"/>
        <GradientStop Color="{StaticResource ColFeltDark}"  Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushGoldButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColGoldLight}" Offset="0"/>
        <GradientStop Color="{StaticResource ColGold}"      Offset="0.5"/>
        <GradientStop Color="{StaticResource ColGoldDark}"  Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColCream}"  Offset="0"/>
        <GradientStop Color="{StaticResource ColCream2}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================ -->
    <!--  TIPOGRAFÍA                                                    -->
    <!-- ============================================================ -->
    <FontFamily x:Key="FontDisplay">Segoe UI Black</FontFamily>
    <FontFamily x:Key="FontBody">Segoe UI</FontFamily>
    <FontFamily x:Key="FontBodySemibold">Segoe UI Semibold</FontFamily>

    <!-- ============================================================ -->
    <!--  SOMBRAS Y RESPLANDORES REUTILIZABLES                          -->
    <!-- ============================================================ -->
    <DropShadowEffect x:Key="ShadowCard"  Color="Black" Opacity="0.45" BlurRadius="28" ShadowDepth="8" Direction="270"/>
    <DropShadowEffect x:Key="ShadowSoft"  Color="Black" Opacity="0.30" BlurRadius="10" ShadowDepth="3" Direction="270"/>
    <DropShadowEffect x:Key="ShadowTiny"  Color="Black" Opacity="0.35" BlurRadius="4"  ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="GlowGold"    Color="#F0B90B" Opacity="0.65" BlurRadius="24" ShadowDepth="0"/>

    <!-- ============================================================ -->
    <!--  ESTILO: Tarjeta / Panel principal                             -->
    <!-- ============================================================ -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
        <Setter Property="Padding" Value="34"/>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Botón primario (dorado)                               -->
    <!-- ============================================================ -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushGoldButton}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushFeltDark}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBodySemibold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrushBorder}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Botón secundario (contorno)                           -->
    <!-- ============================================================ -->
    <Style x:Key="BtnOutline" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushCream2}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBodySemibold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrushBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Tabs                                                  -->
    <!-- ============================================================ -->
    <Style x:Key="TabButtonActive" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="0,11"/>
    </Style>
    <Style x:Key="TabButtonInactive" TargetType="Button" BasedOn="{StaticResource BtnOutline}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="0,11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Campo de texto (TextBox / PasswordBox)                -->
    <!-- ============================================================ -->
    <Style x:Key="InputField" TargetType="Control">
        <Setter Property="Background" Value="{StaticResource BrushCream2}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1.3"/>
    </Style>

    <Style x:Key="TextBoxRounded" TargetType="TextBox" BasedOn="{StaticResource InputField}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushFeltLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordBoxRounded" TargetType="PasswordBox" BasedOn="{StaticResource InputField}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushFeltLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Etiquetas de campo                                    -->
    <!-- ============================================================ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBodySemibold}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWoodDark}"/>
        <Setter Property="Margin" Value="1,0,0,6"/>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Texto de enlace                                       -->
    <!-- ============================================================ -->
    <Style x:Key="LinkText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBodySemibold}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushFeltLight}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ============================================================ -->
    <!--  ESTILO: Título grande con resplandor                          -->
    <!-- ============================================================ -->
    <Style x:Key="TitleDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
        <Setter Property="Effect" Value="{StaticResource GlowGold}"/>
    </Style>

    <Style x:Key="SubtitleDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

</ResourceDictionary>
