<UserControl x:Class="YachtDice.Views.LanguageSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <ToggleButton x:Name="LanguageToggleButton"
                      Click="LanguageToggleButton_Click"
                      Background="#FAF7F0"
                      BorderThickness="0"
                      Padding="10,5"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="CurrentFlagBorder" Width="20" Height="14" CornerRadius="2" Margin="0,0,6,0" ClipToBounds="True">
                    <Grid x:Name="CurrentFlagGrid"/>
                </Border>
                <TextBlock x:Name="CurrentLangText"
                           FontFamily="Oswald"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#2d6a4f"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TODO_Propiedad}" d:Text="▾" Margin="6,0,0,0" FontSize="16" Foreground="#2d6a4f" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="LanguagePopup"
               PlacementTarget="{Binding ElementName=LanguageToggleButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               VerticalOffset="6">
            <Border Background="#FAF7F0"
                    CornerRadius="10"
                    Padding="4"
                    BorderBrush="#d4a017"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Width="120">
                    <Button x:Name="SpanishOptionButton"
                            Click="SpanishOptionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,8,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Fill="#AA151B"/>
                                    <Rectangle Grid.Row="1" Fill="#F1BF00"/>
                                    <Rectangle Grid.Row="2" Fill="#AA151B"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding TODO_Propiedad}" d:Text="Español" FontFamily="Inter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EnglishOptionButton"
                            Click="EnglishOptionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="14" CornerRadius="2" Margin="0,0,8,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Fill="#B22234"/>
                                    <Rectangle Grid.Row="1" Fill="White"/>
                                    <Rectangle Grid.Row="2" Fill="#B22234"/>
                                    <Rectangle Grid.Row="3" Fill="White"/>
                                    <Rectangle Grid.Row="4" Fill="#B22234"/>
                                    <Rectangle Grid.Row="5" Fill="White"/>
                                    <Rectangle Grid.Row="6" Fill="#B22234"/>
                                    <Rectangle Grid.RowSpan="4" Width="9" HorizontalAlignment="Left" Fill="#3C3B6E"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding TODO_Propiedad}" d:Text="English" FontFamily="Inter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
