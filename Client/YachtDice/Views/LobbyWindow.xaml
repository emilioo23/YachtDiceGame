<Window x:Class="YachtDice.Views.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:YachtDice.Resources"
        xmlns:views="clr-namespace:YachtDice.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{x:Static properties:Strings.Auth_Logo}"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFeltBackground}"
        FontFamily="{StaticResource FontBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Margin="24"
              Width="1280"
              Height="800">

            <views:LanguageSwitcher x:Name="LanguageSwitcherControl"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-16,0,0"
                                     Panel.ZIndex="99"/>

            <Button x:Name="BackToMenuButton"
                    Content="{x:Static properties:Strings.Lobby_ButtonBackToMenu}"
                    Style="{StaticResource BtnOutline}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="20,10"
                    FontSize="16"
                    Panel.ZIndex="99"
                    Click="BackToMenuButton_Click"/>

            <Grid Width="300"
                  Height="720"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <views:InviteFriendsPanel x:Name="FriendsPanel"
                                          Grid.Row="0"
                                          Margin="0,0,0,14"/>

                <views:ChatPanel x:Name="ChatPanelControl"
                                 Grid.Row="1"
                                 PanelHeight="330"/>
            </Grid>

            <Border Style="{StaticResource CardPanel}"
                    Width="760"
                    Margin="0,0,300,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Static properties:Strings.Lobby_Title}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="36"
                                   Foreground="{StaticResource BrushText}"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource BrushCream2}"
                                CornerRadius="8"
                                Padding="12,6">

                            <TextBlock x:Name="RoomCodeTextBlock"
                                       FontWeight="Bold"
                                       FontSize="23"
                                       Foreground="{StaticResource BrushWoodDark}"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_Privacy}"
                                       Style="{StaticResource FieldLabel}"
                                       FontSize="15"/>

                            <ComboBox x:Name="PrivacyComboBox"
                                      Padding="10,8"
                                      FontSize="17"
                                      SelectedIndex="0"
                                      SelectionChanged="SettingsComboBox_SelectionChanged">

                                <ComboBoxItem x:Name="PrivateOptionItem"
                                              Content="{x:Static properties:Strings.Lobby_OptionPrivate}"/>
                                <ComboBoxItem x:Name="PublicOptionItem"
                                              Content="{x:Static properties:Strings.Lobby_OptionPublic}"/>

                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="{x:Static properties:Strings.Lobby_MaxPlayers}"
                                       Style="{StaticResource FieldLabel}"
                                       FontSize="15"/>

                            <ComboBox x:Name="MaxPlayersComboBox"
                                      Padding="10,8"
                                      FontSize="17"
                                      SelectedIndex="2"
                                      SelectionChanged="SettingsComboBox_SelectionChanged">

                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>

                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Static properties:Strings.Lobby_GameMode}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NormalModeBorder"
                                Grid.Column="0"
                                Background="{StaticResource BrushCream2}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource BrushFeltLight}"
                                BorderThickness="2"
                                Padding="16"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="NormalMode_Click">

                            <StackPanel>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode1MinuteTitle}"
                                           FontFamily="{StaticResource FontBodySemibold}"
                                           FontSize="19"
                                           Foreground="{StaticResource BrushWoodDark}"/>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode1MinuteSub}"
                                           FontSize="15"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>

                            </StackPanel>
                        </Border>

                        <Border x:Name="FastModeBorder"
                                Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5"
                                Padding="16"
                                Margin="10,0,0,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="FastMode_Click">

                            <StackPanel>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode30SecondsTitle}"
                                           FontFamily="{StaticResource FontBodySemibold}"
                                           FontSize="19"
                                           Foreground="{StaticResource BrushWoodDark}"/>

                                <TextBlock Text="{x:Static properties:Strings.Lobby_Mode30SecondsSub}"
                                           FontSize="15"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>

                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,10">

                        <TextBlock Text="{x:Static properties:Strings.Lobby_Players}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"/>

                        <TextBlock x:Name="PlayerCountTextBlock"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="PlayerSlotsItemsControl"
                                  Margin="-3,0,-3,24">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,0">

                                    <Border Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="{StaticResource BrushCream2}"
                                            CornerRadius="8"
                                            Padding="10">

                                        <StackPanel Orientation="Horizontal">

                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="15"
                                                    Background="{StaticResource BrushWood}"
                                                    Margin="0,0,8,0">

                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="15"/>
                                            </Border>

                                            <StackPanel>

                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           Foreground="{StaticResource BrushText}"/>

                                                <TextBlock Text="{x:Static properties:Strings.Lobby_Host}"
                                                           Visibility="{Binding IsHost, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushFeltLight}"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            Padding="10">

                                        <TextBlock Text="{x:Static properties:Strings.Lobby_WaitingPlayer}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{x:Static properties:Strings.Lobby_ButtonCopyCode}"
                                Style="{StaticResource BtnOutline}"
                                Margin="0,0,10,0"
                                Padding="0,13"
                                FontSize="17"
                                Click="CopyCodeButton_Click"/>

                        <Button x:Name="StartGameButton"
                                Grid.Column="1"
                                Content="{x:Static properties:Strings.Lobby_ButtonStartMatch}"
                                Style="{StaticResource BtnPrimary}"
                                FontSize="17"
                                Padding="0,13"
                                Click="StartGameButton_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>